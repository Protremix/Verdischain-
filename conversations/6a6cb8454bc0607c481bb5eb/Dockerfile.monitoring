FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic redis psycopg2-binary pytest

COPY documentation_api.py /app/documentation_api.py
COPY monitoring_metrics.py /app/monitoring_metrics.py
COPY monitoring_api.py /app/monitoring_api.py

ENV GATEWAY_URL=http://localhost:3500
ENV AGENT_URL=http://localhost:3600

EXPOSE 3700

CMD ["uvicorn", "monitoring_api:app", "--host", "0.0.0.0", "--port", "3700", "--workers", "1"]
