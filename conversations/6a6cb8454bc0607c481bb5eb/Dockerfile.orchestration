FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic pytest pytest-asyncio

COPY orchestration_engine.py /app/orchestration_engine.py
COPY orchestration_api.py /app/orchestration_api.py

ENV GATEWAY_URL=http://localhost:3500
ENV AGENT_URL=http://localhost:3600
ENV WORKFLOW_PERSIST_PATH=/tmp/workflows.json

EXPOSE 3800

CMD ["uvicorn", "orchestration_api:app", "--host", "0.0.0.0", "--port", "3800", "--workers", "1"]
