<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_validator"
            android:background="@drawable/bg_action_icon"
            android:padding="8dp"
            app:tint="#10B981"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_validator_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0x0000...0000"
                android:textSize="14sp"
                android:textColor="#ECFDF5"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_validator_votes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,000,000 votes"
                android:textSize="12sp"
                android:textColor="#4A6B5A"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_validator_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40"
                android:textSize="18sp"
                android:textColor="#34D399"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_score_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="green score"
                android:textSize="10sp"
                android:textColor="#4A6B5A"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
