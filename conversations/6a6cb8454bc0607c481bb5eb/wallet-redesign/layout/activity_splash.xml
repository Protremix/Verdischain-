<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1410"
    android:gravity="center"
    android:padding="40dp">

    <!-- Logo with subtle glow -->
    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="40dp">

        <!-- Glow background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/splash_glow"
            android:alpha="0.15" />

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/verdis_logo"
            android:contentDescription="Verdis Logo" />
    </FrameLayout>

    <!-- App name -->
    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verdis"
        android:textSize="36sp"
        android:textColor="#ECFDF5"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:visibility="invisible"
        android:layout_marginBottom="8dp" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Green Wallet"
        android:textSize="14sp"
        android:textColor="#10B981"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif"
        android:visibility="invisible"
        android:layout_marginTop="2dp" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/splash_progress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:indeterminateTint="#10B981"
        android:visibility="invisible" />

</LinearLayout>
