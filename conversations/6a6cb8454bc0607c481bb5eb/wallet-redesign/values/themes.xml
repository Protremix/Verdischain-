<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme - Professional Dark -->
    <style name="Theme.VerdisWallet" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#10B981</item>
        <item name="colorOnPrimary">#0B1410</item>
        <item name="colorPrimaryContainer">#0F1B15</item>
        <item name="colorOnPrimaryContainer">#34D399</item>
        <item name="colorSecondary">#7B9A89</item>
        <item name="colorSecondaryContainer">#142420</item>
        <item name="colorOnSecondaryContainer">#ECFDF5</item>
        <item name="android:colorBackground">#0B1410</item>
        <item name="colorSurface">#0F1B15</item>
        <item name="colorOnSurface">#ECFDF5</item>
        <item name="colorSurfaceVariant">#142420</item>
        <item name="colorOnSurfaceVariant">#7B9A89</item>
        <item name="colorOutline">#1A2B23</item>
        <item name="colorError">#EF4444</item>
        <item name="colorOnError">#ECFDF5</item>
        <item name="android:statusBarColor">#0B1410</item>
        <item name="android:navigationBarColor">#0F1B15</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.VerdisSplash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">#0B1410</item>
        <item name="android:statusBarColor">#0B1410</item>
        <item name="android:navigationBarColor">#0B1410</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.Verdis.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>
    
    <!-- Button styles -->
    <style name="Widget.Verdis.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">#0B1410</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    
    <style name="Widget.Verdis.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">#ECFDF5</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    
    <!-- Text styles -->
    <style name="TextAppearance.Verdis.Headline" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">#ECFDF5</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    
    <style name="TextAppearance.Verdis.Title" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#ECFDF5</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="TextAppearance.Verdis.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#7B9A89</item>
    </style>
    
    <style name="TextAppearance.Verdis.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#4A6B5A</item>
    </style>
    
    <style name="TextAppearance.Verdis.Balance" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">#ECFDF5</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
</resources>
