{
  "name": "verdis-chain-e2e",
  "version": "1.0.0",
  "description": "E2E tests for Verdis Chain web applications",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:wallet": "cypress run --spec cypress/e2e/wallet.cy.js",
    "test:dex": "cypress run --spec cypress/e2e/dex.cy.js",
    "test:explorer": "cypress run --spec cypress/e2e/explorer.cy.js",
    "test:landing": "cypress run --spec cypress/e2e/landing.cy.js",
    "test:api": "cypress run --spec cypress/e2e/api.cy.js",
    "test:mobile": "cypress run --config viewportWidth=375,viewportHeight=667"
  },
  "devDependencies": {
    "cypress": "^13.15.0"
  }
}
