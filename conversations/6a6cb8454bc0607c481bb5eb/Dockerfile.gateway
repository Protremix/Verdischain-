FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic redis pytest pytest-asyncio

COPY ai_gateway.py /app/ai_gateway.py
COPY gateway_security.py /app/gateway_security.py
COPY openai_plugin.py /app/plugins/openai_gpt4o.py
COPY sentiment_plugin.py /app/plugins/sentiment_analyzer.py
COPY code_review_plugin.py /app/plugins/code_reviewer.py

RUN mkdir -p /app/plugins

ENV AI_GATEWAY_PORT=3400
ENV PLUGIN_DIR=/app/plugins
ENV REGISTRY_FILE=/app/plugin_registry.json

EXPOSE 3400

CMD ["uvicorn", "ai_gateway:app", "--host", "0.0.0.0", "--port", "3400", "--workers", "1"]
