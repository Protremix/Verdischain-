<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1410"
    android:gravity="center">

    <!-- Logo -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/verdis_logo"
        android:layout_marginBottom="24dp"
        android:contentDescription="Verdis" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unlock Verdis"
        android:textSize="22sp"
        android:textColor="#ECFDF5"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="32dp" />

    <!-- PIN dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <View
            android:id="@+id/pin_dot_1"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/pin_dot_2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/pin_dot_3"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/pin_dot_4"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/pin_dot_5"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginEnd="12dp" />

        <View
            android:id="@+id/pin_dot_6"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <!-- Keypad -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_3"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_4"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_5"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_6"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_7"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_8"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_9"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4: delete 0 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="6dp" />

            <LinearLayout
                android:id="@+id/btn_0"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/pin_key_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textColor="#ECFDF5"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_delete"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_back"
                    app:tint="#7B9A89"
                    android:contentDescription="Delete" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
