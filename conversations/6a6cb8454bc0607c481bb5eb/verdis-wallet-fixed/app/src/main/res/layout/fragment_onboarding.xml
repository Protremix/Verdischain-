<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050A08"
    android:padding="24dp"
    android:gravity="center">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_verdis_logo"
        android:layout_marginBottom="32dp"
        android:contentDescription="Verdis Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verdis Wallet"
        android:textSize="28sp"
        android:textColor="#F0FDF4"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Fully Green Blockchain"
        android:textSize="14sp"
        android:textColor="#547363"
        android:layout_marginBottom="48dp" />

    <!-- Create Wallet Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Create New Wallet"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#00FF88"
        app:cornerRadius="16dp"
        android:textColor="#050A08"
        android:layout_marginBottom="12dp" />

    <!-- Import Wallet Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_import"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Import Wallet"
        android:textSize="16sp"
        app:backgroundTint="#0A120E"
        app:strokeColor="#1A00FF88"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        android:textColor="#00FF88"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By continuing you agree to the Terms of Service and Privacy Policy"
        android:textSize="11sp"
        android:textColor="#3A5040"
        android:textAlignment="center"
        android:gravity="center" />

</LinearLayout>
