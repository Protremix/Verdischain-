<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050A08"
    android:gravity="center"
    android:padding="40dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_verdis_logo"
        android:layout_marginBottom="32dp"
        android:contentDescription="Verdis Logo" />

    <!-- Animated "VERDIS" letters container -->
    <LinearLayout
        android:id="@+id/letters_container"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="First Fully Green Blockchain"
        android:textSize="13sp"
        android:textColor="#547363"
        android:letterSpacing="0.08"
        android:visibility="invisible"
        android:layout_marginTop="4dp" />

</LinearLayout>
