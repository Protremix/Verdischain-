<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A08">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Validators"
                android:textSize="24sp"
                android:textColor="#F0FDF4"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Staking Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_balance_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Stake"
                            android:textSize="12sp"
                            android:textColor="#8BA898" />
                        <TextView
                            android:id="@+id/tv_your_stake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 VCO"
                            android:textSize="18sp"
                            android:textColor="#F0FDF4"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rewards"
                            android:textSize="12sp"
                            android:textColor="#8BA898" />
                        <TextView
                            android:id="@+id/tv_rewards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 VCO"
                            android:textSize="18sp"
                            android:textColor="#00FF88"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_claim_rewards"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Claim Rewards"
                    android:textSize="13sp"
                    app:backgroundTint="#0A120E"
                    app:strokeColor="#1A00FF88"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    android:textColor="#00FF88"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Active Validators Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Validators"
                android:textSize="16sp"
                android:textColor="#F0FDF4"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Validators List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_validators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
