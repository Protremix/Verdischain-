<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1410">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token Sale (IDO)"
            android:textSize="20sp"
            android:textColor="#ECFDF5"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <!-- Sale info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_balance_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price"
                        android:textSize="12sp"
                        android:textColor="#7B9A89" />

                    <TextView
                        android:id="@+id/tv_ido_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.001 per VCO"
                        android:textSize="18sp"
                        android:textColor="#34D399"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Balance"
                        android:textSize="12sp"
                        android:textColor="#7B9A89" />

                    <TextView
                        android:id="@+id/tv_ido_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 VCO"
                        android:textSize="18sp"
                        android:textColor="#ECFDF5"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A2B23"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_ido_sold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 VCO sold"
                android:textSize="13sp"
                android:textColor="#ECFDF5"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_ido_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10,000,000,000 VCO remaining"
                android:textSize="13sp"
                android:textColor="#4A6B5A"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progress_sale"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="0"
                android:max="100"
                android:progressTint="#10B981"
                android:progressBackgroundTint="#1A2B23"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_ido_purchasers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 purchasers"
                android:textSize="12sp"
                android:textColor="#4A6B5A" />
        </LinearLayout>

        <!-- Purchase form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy VCO Tokens"
                android:textSize="15sp"
                android:textColor="#ECFDF5"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amount (VCO)"
                android:textSize="13sp"
                android:textColor="#7B9A89"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_ido_amount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Minimum 100 VCO"
                android:inputType="numberDecimal"
                android:textSize="18sp"
                android:textColor="#ECFDF5"
                android:textColorHint="#3A5246"
                android:background="@drawable/bg_input"
                android:padding="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_ido_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cost: $0.0"
                android:textSize="14sp"
                android:textColor="#34D399"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/btn_ido_buy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buy VCO"
                    android:textSize="15sp"
                    android:textColor="#0B1410"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ido_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#34D399"
                android:textAlignment="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Info note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tokens are credited instantly to your Verdis wallet after purchase. Use the Send and Swap tabs to transfer or trade your VCO."
            android:textSize="12sp"
            android:textColor="#4A6B5A"
            android:layout_marginStart="4dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
