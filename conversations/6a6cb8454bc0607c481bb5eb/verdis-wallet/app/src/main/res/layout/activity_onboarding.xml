<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Leaf"
                android:src="@drawable/ic_verdis_leaf" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="VERDIS WALLET SETUP"
                android:textColor="#e4e4e7"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Select an option to initialize your secure Ed25519 wallet."
            android:textColor="#8b8b8f"
            android:textSize="13sp" />

        <!-- Tab Mode Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_mode_create"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="Create New Wallet"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_mode_import"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="Import Wallet"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CREATE WALLET SECTION -->
        <LinearLayout
            android:id="@+id/section_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Seed Phrase Display Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_accent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secret 12-Word Seed Phrase"
                    android:textColor="#00d97e"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Write down these words carefully. Keep them secret!"
                    android:textColor="#8b8b8f"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_seed_phrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:text="generating seed phrase..."
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_copy_seed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_secondary"
                    android:paddingHorizontal="16dp"
                    android:text="Copy Seed"
                    android:textColor="#e4e4e7"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- IMPORT WALLET SECTION -->
        <LinearLayout
            android:id="@+id/section_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Seed Phrase or Private Key"
                android:textColor="#e4e4e7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_import_seed"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="Paste 12 words or hex private key..."
                android:padding="12dp"
                android:textColor="#e4e4e7"
                android:textColorHint="#8b8b8f"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- PIN SETUP (Common to both) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Security PIN (6 Digits)"
                android:textColor="#e4e4e7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_pin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Enter 6-digit PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="#e4e4e7"
                android:textColorHint="#8b8b8f"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Confirm 6-digit PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="#e4e4e7"
                android:textColorHint="#8b8b8f"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- SUBMIT BUTTON -->
        <Button
            android:id="@+id/btn_finish_setup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_primary"
            android:text="Initialize Wallet"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
