FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic redis

COPY plugin_architecture.py intelligent_router.py specialized_providers.py llm_providers.py gateway_v2_api.py /app/

EXPOSE 3400

CMD ["uvicorn", "gateway_v2_api:app", "--host", "0.0.0.0", "--port", "3400", "--workers", "1"]
