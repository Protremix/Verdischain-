FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic redis psycopg2-binary pytest

COPY agent_framework.py /app/agent_framework.py
COPY agent_api.py /app/agent_api.py

ENV AGENT_REGISTRY_FILE=/app/agent_registry.json
ENV TASK_HISTORY_FILE=/app/task_history.json
ENV DATABASE_URL=postgresql://evolvixos:evolvixos@host.docker.internal:5432/evolvixos
ENV GATEWAY_URL=http://host.docker.internal:3500

EXPOSE 3600

CMD ["uvicorn", "agent_api:app", "--host", "0.0.0.0", "--port", "3600", "--workers", "1"]
