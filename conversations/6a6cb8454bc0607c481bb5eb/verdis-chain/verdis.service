[Unit]
Description=Verdis Chain Node v2.0 (Rust + Substrate)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/verdis-chain-rust
ExecStart=/opt/verdis-chain-rust/target/release/verdis run --validator --name "verdis-chain-v2" --port 30333 --rpc-port 9933 --rpc-external --ws-port 9944 --ws-external
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="RUST_LOG=info"
Environment="RUST_BACKTRACE=1"
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
