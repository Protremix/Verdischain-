<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A08"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Balance Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_balance_card"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Balance"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="#8BA898"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#00FF88"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0x..."
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="#547363"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ⎘"
                    android:textSize="14sp"
                    android:textColor="#547363" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Send -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_quick_action"
                android:padding="14dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/action_send"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:background="@drawable/bg_action_icon"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:textSize="11sp"
                    android:textColor="#8BA898"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Receive -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_quick_action"
                android:padding="14dp"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/action_receive"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/stat_sys_download"
                    android:background="@drawable/bg_action_icon"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receive"
                    android:textSize="11sp"
                    android:textColor="#8BA898"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Swap -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_quick_action"
                android:padding="14dp"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/action_swap"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="@drawable/bg_action_icon"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swap"
                    android:textSize="11sp"
                    android:textColor="#8BA898"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_quick_action"
                android:padding="14dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/action_history"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="@drawable/bg_action_icon"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textSize="11sp"
                    android:textColor="#8BA898"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tokens"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F0FDF4"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00FF88" />

        <!-- Tokens List -->
        <LinearLayout
            android:id="@+id/tokens_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
