FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn httpx structlog pydantic pytest pytest-asyncio

COPY load_test.py /app/load_test.py
COPY load_test_api.py /app/load_test_api.py

ENV GATEWAY_URL=http://localhost:3500
ENV AGENT_URL=http://localhost:3600
ENV BLOCKCHAIN_URL=http://localhost:3200
ENV ORCHESTRATION_URL=http://localhost:3800

EXPOSE 3900

CMD ["uvicorn", "load_test_api:app", "--host", "0.0.0.0", "--port", "3900", "--workers", "1"]
