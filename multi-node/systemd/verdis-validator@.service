[Unit]
Description=Verdis Validator Node #%i
After=network.target
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/verdis-chain-rust/target/release/verdis \
  --chain /opt/verdis-chain-rust/multi-node/chain-spec.json \
  --base-path /opt/verdis-chain-rust/data-validator-%i \
  --validator \
  --port %i \
  --node-key-file /opt/verdis-chain-rust/multi-node/keys/validator-%i.node.key \
  --keystore /opt/verdis-chain-rust/data-validator-%i/keystore \
  --bootnodes /dns/bootnode1.verdischain.com/tcp/30333/p2p/PLACEHOLDER \
  --bootnodes /dns/bootnode2.verdischain.com/tcp/30333/p2p/PLACEHOLDER
Restart=always
RestartSec=10
User=root
StandardOutput=append:/var/log/verdis-validator-%i.log
StandardError=append:/var/log/verdis-validator-%i.log

[Install]
WantedBy=multi-user.target
