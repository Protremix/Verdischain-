<div id="verdis-footer"></div>

<script>
function toggleFaqCard(el) {
    el.classList.toggle('active');
}

function runStakingCalc() {
    const val = document.getElementById('calc-range').value;
    document.getElementById('calc-val-text').textContent = parseInt(val).toLocaleString() + ' VRDX';
    const annual = Math.round(val * 0.085);
    const monthly = Math.round(annual / 12);
    document.getElementById('calc-reward').textContent = annual.toLocaleString() + ' VRDX';
    document.getElementById('calc-monthly').textContent = monthly.toLocaleString() + ' VRDX';
}
</script>

