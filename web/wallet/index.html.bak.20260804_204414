  <style>
    /* ============================================================
       VERDIS WALLET EXTENDED DESIGN SYSTEM STYLES
       ============================================================ */
    :root {
      --sidebar-width: 240px;
      --header-height: 64px;
      --bottom-nav-height: 60px;
    }

    /* Layout Structure */
    .wallet-app {
      display: flex;
      min-height: 100vh;
      background: var(--bg-primary);
      position: relative;
      padding-top: var(--header-height);
    }

    /* Sub-header / Wallet Top Status Bar */
    .wallet-topbar {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      height: 48px;
      background: rgba(17, 24, 17, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      z-index: 990;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 var(--space-xl);
      font-size: 13px;
    }

    .status-left, .status-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .network-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: rgba(0, 255, 136, 0.08);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
    }

    .network-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
    }

    .rpc-indicator {
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 12px;
    }

    /* Wallet Navigation Sidebar (Desktop) */
    .wallet-sidebar {
      width: var(--sidebar-width);
      position: fixed;
      top: calc(var(--header-height) + 48px);
      bottom: 0;
      left: 0;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      padding: var(--space-md) var(--space-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 900;
      overflow-y: auto;
    }

    .nav-tabs {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .nav-tab-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      width: 100%;
      background: transparent;
      border: 1px solid transparent;
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition);
      text-align: left;
    }

    .nav-tab-btn:hover {
      color: var(--accent);
      background: rgba(0, 255, 136, 0.05);
      border-color: rgba(0, 255, 136, 0.1);
    }

    .nav-tab-btn.active {
      color: #000;
      background: var(--gradient-accent);
      font-weight: 600;
      box-shadow: var(--shadow-glow);
    }

    .nav-tab-btn svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    /* Main Content Area */
    .wallet-content {
      margin-left: var(--sidebar-width);
      margin-top: 48px;
      flex: 1;
      padding: var(--space-xl);
      max-width: 1280px;
      width: calc(100% - var(--sidebar-width));
      padding-bottom: calc(var(--space-3xl) + 40px);
    }

    /* Tab Panels */
    .tab-panel {
      display: none;
      animation: fadeIn 300ms ease-out;
    }

    .tab-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Hero / Header Cards in Tabs */
    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--space-xl);
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .panel-title {
      font-size: 26px;
      font-weight: 700;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .panel-desc {
      font-size: 14px;
      color: var(--text-secondary);
      margin-top: 2px;
    }

    /* Connection Card / Banner */
    .connection-banner {
      background: var(--gradient-accent-soft);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-lg);
      padding: var(--space-lg);
      margin-bottom: var(--space-xl);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-md);
    }

    .connection-info h3 {
      font-size: 18px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 4px;
    }

    .connection-info p {
      font-size: 13px;
      color: var(--text-secondary);
    }

    .address-input-group {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      max-width: 540px;
    }

    .form-control {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 13px;
      transition: var(--transition);
    }

    .form-control:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--accent-glow);
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    /* Quick Action Buttons Bar */
    .quick-actions-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--space-md);
      margin-bottom: var(--space-xl);
    }

    .action-btn-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: var(--transition);
      text-align: center;
      color: var(--text-primary);
    }

    .action-btn-card:hover {
      border-color: var(--accent);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      color: var(--accent);
    }

    .action-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--accent-glow);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: bold;
    }

    /* Asset & DEX Grid Layouts */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .grid-3col {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-lg);
    }

    @media (max-width: 992px) {
      .grid-2col { grid-template-columns: 1fr; }
    }

    /* Custom NFT / Carbon Credit Cards */
    .nft-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--space-md);
      margin-top: var(--space-md);
    }

    .nft-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: var(--transition);
    }

    .nft-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .nft-preview {
      width: 100%;
      height: 140px;
      background: linear-gradient(135deg, #112a18 0%, #0a180e 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .nft-badge {
      position: absolute;
      top: 8px;
      right: 8px;
      font-size: 10px;
    }

    .nft-details {
      padding: var(--space-md);
    }

    .nft-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .nft-meta {
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    /* AMM Swap Box */
    .swap-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: var(--space-xl);
      max-width: 480px;
      margin: 0 auto;
    }

    .swap-input-box {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-md);
      margin-bottom: 8px;
    }

    .swap-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .swap-token-select {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 6px 10px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      cursor: pointer;
    }

    .swap-amount-input {
      background: transparent;
      border: none;
      color: var(--text-primary);
      font-size: 22px;
      font-weight: 700;
      text-align: right;
      width: 160px;
      font-family: var(--font-mono);
    }

    .swap-amount-input:focus {
      outline: none;
    }

    .swap-divider {
      display: flex;
      justify-content: center;
      margin: -10px 0;
      position: relative;
      z-index: 5;
    }

    .swap-switch-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-accent);
      color: var(--accent);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition);
    }

    .swap-switch-btn:hover {
      transform: rotate(180deg);
      background: var(--accent-glow);
    }

    /* Validator Cards */
    .validator-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-md);
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: var(--transition);
      margin-bottom: 8px;
    }

    .validator-card:hover {
      border-color: var(--border-light);
    }

    .green-score {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--accent);
      background: rgba(0, 255, 136, 0.1);
      padding: 2px 8px;
      border-radius: var(--radius-sm);
    }

    /* Modal Overlay */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: var(--space-md);
    }

    .modal-overlay.active {
      display: flex;
    }

    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 560px;
      padding: var(--space-xl);
      position: relative;
      box-shadow: var(--shadow-lg);
      animation: modalUp 250ms ease-out;
    }

    @keyframes modalUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-close {
      position: absolute;
      top: var(--space-md);
      right: var(--space-md);
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 20px;
      cursor: pointer;
    }

    .modal-close:hover { color: var(--text-primary); }

    /* Bottom Navigation for Mobile */
    .wallet-bottom-nav {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: var(--bottom-nav-height);
      background: rgba(17, 24, 17, 0.95);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border);
      z-index: 1000;
      justify-content: space-around;
      align-items: center;
      padding: 0 4px;
    }

    .bottom-nav-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 10px;
      font-weight: 500;
      cursor: pointer;
      flex: 1;
      padding: 6px 0;
    }

    .bottom-nav-btn.active {
      color: var(--accent);
    }

    .bottom-nav-btn svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    @media (max-width: 768px) {
      .wallet-sidebar { display: none; }
      .wallet-content {
        margin-left: 0;
        width: 100%;
        padding: var(--space-md);
        padding-bottom: calc(var(--bottom-nav-height) + 30px);
      }
      .wallet-bottom-nav { display: flex; }
      .wallet-topbar { padding: 0 var(--space-md); }
    }

    /* Filter Pills */
    .filter-pills {
      display: flex;
      gap: 8px;
      margin-bottom: var(--space-md);
      flex-wrap: wrap;
    }

    .filter-pill {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      padding: 6px 14px;
      border-radius: var(--radius-full);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-pill.active, .filter-pill:hover {
      color: var(--accent);
      border-color: var(--accent);
      background: var(--accent-glow);
    }
  </style>
