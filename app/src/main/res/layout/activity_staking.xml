<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Staking"
            android:textColor="#e4e4e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Stakes"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/totalStakedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 VRS"
                android:textColor="#00d97e"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Validators"
            android:textColor="#e4e4e7"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/validatorList"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#2a2a2e"
            android:dividerHeight="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/stakeAmountInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Amount to stake"
                android:textColorHint="#8b8b8f"
                android:textColor="#e4e4e7"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/stakeBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Stake"
                android:background="@drawable/btn_primary"
                android:textColor="#18181a"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
