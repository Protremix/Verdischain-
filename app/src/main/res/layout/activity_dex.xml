<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEX Swap"
            android:textColor="#e4e4e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/pairSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/amountInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="From amount"
                android:textColorHint="#8b8b8f"
                android:textColor="#e4e4e7"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textColor="#00d97e"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/estOutputText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Estimated: 0.00"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/priceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: -"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/swapBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Swap"
                android:background="@drawable/btn_primary"
                android:textColor="#18181a"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liquidity Pools"
            android:textColor="#e4e4e7"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/poolList"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:divider="#2a2a2e"
            android:dividerHeight="1dp" />
    </LinearLayout>
</ScrollView>
