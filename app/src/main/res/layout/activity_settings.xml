<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#e4e4e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Network Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Network"
            android:textColor="#00d97e"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RPC URL"
                android:textColor="#8b8b8f"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/rpcUrlInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#e4e4e7"
                android:textSize="13sp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/saveRpcBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Save"
                android:background="@drawable/btn_secondary"
                android:textColor="#00d97e"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Security Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textColor="#00d97e"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Biometric Auth"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/biometricSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/changePinBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Change PIN"
                android:background="@drawable/btn_secondary"
                android:textColor="#00d97e"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/exportWalletBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Export Wallet"
                android:background="@drawable/btn_secondary"
                android:textColor="#e4e4e7"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Notifications Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textColor="#00d97e"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Master toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Push Notifications"
                        android:textColor="#e4e4e7"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monitor blockchain for events"
                        android:textColor="#8b8b8f"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/notifMasterSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2a2a2e"
                android:layout_marginBottom="12dp" />

            <!-- Transaction notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Transaction Alerts"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/notifTxSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Staking notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Staking Rewards"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/notifStakingSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Epoch notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Epoch Transitions"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/notifEpochSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Validator notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Validator Status"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/notifValidatorSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2a2a2e"
                android:layout_marginBottom="12dp" />

            <!-- Monitor interval -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Interval"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/notifIntervalSeekbar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:max="22" />

                <TextView
                    android:id="@+id/notifIntervalText"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="20s"
                    android:textColor="#e4e4e7"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/testNotifBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Send Test Notification"
                android:background="@drawable/btn_secondary"
                android:textColor="#00d97e"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- About Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textColor="#00d97e"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verdis Wallet v2.1.0"
                android:textColor="#e4e4e7"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verdis Chain - verdischain.com"
                android:textColor="#8b8b8f"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
