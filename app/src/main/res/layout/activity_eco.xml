<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eco Dashboard"
            android:textColor="#e4e4e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e1e22"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carbon Credits"
                android:textColor="#8b8b8f"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/carbonCreditsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 CARBON"
                android:textColor="#00d97e"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Green Validator Score"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <ProgressBar
                android:id="@+id/greenScoreBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00d97e" />

            <TextView
                android:id="@+id/greenScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0/100"
                android:textColor="#8b8b8f"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/mintCarbonBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Mint Carbon Credit"
                android:background="@drawable/btn_primary"
                android:textColor="#18181a"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reforestation Projects"
            android:textColor="#e4e4e7"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/projectList"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:divider="#2a2a2e"
            android:dividerHeight="1dp" />
    </LinearLayout>
</ScrollView>
