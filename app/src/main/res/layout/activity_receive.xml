<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receive VRS"
            android:textColor="#e4e4e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1e1e22"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="#ffffff"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/addressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00d97e"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/copyBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Copy Address"
                android:background="@drawable/btn_primary"
                android:textColor="#18181a"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share your address to receive VRS tokens"
            android:textColor="#8b8b8f"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
